@page "/checkout"
@rendermode InteractiveServer
@using FluentValidation
@using SportNutritionShop.Data.Entities
@using SportNutritionShop.Data.Repositories
@using SportNutritionShop.Services
@using SportNutritionShop.Validators
@inject ICartService CartService
@inject IOrderRepository OrderRepository
@inject IValidator<Customer> Validator
@inject NavigationManager NavigationManager

<h3>Оформление заказа</h3>

@if (cartItems.Count == 0)
{
    <div class="alert alert-warning">Корзина пуста</div>
    <a href="/cart" class="btn btn-outline-primary">Вернуться в корзину</a>
}
else
{
    <EditForm Model="customer" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary class="alert alert-danger" />

        <div class="mb-3">
            <label class="form-label">ФИО *</label>
            <InputText @bind-Value="customer.FullName" class="form-control" />
            <ValidationMessage For="@(() => customer.FullName)" class="text-danger" />
        </div>

        <div class="mb-3">
            <label class="form-label">Телефон *</label>
            <InputText @bind-Value="customer.Phone" class="form-control" placeholder="+7 (___) ___-__-__" />
            <ValidationMessage For="@(() => customer.Phone)" class="text-danger" />
        </div>

        <div class="mb-3">
            <label class="form-label">Email *</label>
            <InputText @bind-Value="customer.Email" class="form-control" />
            <ValidationMessage For="@(() => customer.Email)" class="text-danger" />
        </div>

        <div class="mb-3">
            <label class="form-label">Адрес доставки *</label>
            <InputTextArea @bind-Value="customer.DeliveryAddress" class="form-control" rows="3" />
            <ValidationMessage For="@(() => customer.DeliveryAddress)" class="text-danger" />
        </div>

        <div class="alert alert-info">
            <strong>Сумма заказа:</strong> @totalAmount.ToString("0.00 ₽")
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-success">Подтвердить заказ</button>
            <a href="/cart" class="btn btn-outline-secondary">Назад</a>
        </div>
    </EditForm>
}

@code {
    private Customer customer = new();
    private List<CartItem> cartItems = new();
    private decimal totalAmount = 0;

    protected override async Task OnInitializedAsync()
    {
        cartItems = await CartService.GetCartItemsAsync();
        totalAmount = await CartService.GetTotalAmountAsync();
    }

    private async Task HandleValidSubmit()
    {
        // Валидация через FluentValidation
        var validationResult = await Validator.ValidateAsync(customer);
        if (!validationResult.IsValid)
        {
            foreach (var error in validationResult.Errors)
            {
                Console.WriteLine($"{error.PropertyName}: {error.ErrorMessage}");
            }
            return;
        }

        // Создание заказа
        var order = new Order
        {
            Customer = customer,
            OrderDate = DateTime.UtcNow,
            Items = new List<OrderItem>()
        };

        foreach (var item in cartItems)
        {
            order.Items.Add(new OrderItem
            {
                Product = item.Product,
                Quantity = item.Quantity,
                UnitPrice = item.Product.Price
            });
        }

        order.TotalAmount = totalAmount;

        await OrderRepository.CreateAsync(order);
        await CartService.ClearCartAsync();

        NavigationManager.NavigateTo("/success");
    }
}