@page "/catalog"
@rendermode InteractiveServer
@using SportNutritionShop.Data.Entities
@using SportNutritionShop.Data.Repositories
@using SportNutritionShop.Services
@inject IProductRepository ProductRepository
@inject ICartService CartService

<h3>Каталог товаров</h3>

<div class="row mb-3">
    <div class="col-md-3">
        <select class="form-select" value="@selectedCategoryId" @onchange="OnCategoryChanged">
            <option value="0">Все категории</option>
            @foreach (var category in categories)
            {
                <option value="@category.Id">@category.Name</option>
            }
        </select>
    </div>
    <div class="col-md-6">
        <input type="text" class="form-control" placeholder="Поиск..." @bind="searchTerm" @oninput="FilterProducts" />
    </div>
</div>

<div class="row">
    @if (filteredProducts.Any())
    {
        @foreach (var product in filteredProducts)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name" style="height: 200px; object-fit: cover;" />
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@product.Name</h5>
                        <p class="card-text text-muted">@product.Category?.Name</p>
                        <p class="card-text">@product.Description</p>
                        <p class="card-text fw-bold">@product.Price.ToString("0.00 ₽")</p>

                        <!-- 🔘 КНОПКА ДОБАВЛЕНИЯ -->
                        <button class="btn btn-primary mt-auto" @onclick="() => AddToCart(product)">
                            В корзину
                        </button>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="alert alert-info">Товары не найдены</div>
        </div>
    }
</div>

@code {
    private IEnumerable<Product> allProducts = new List<Product>();
    private IEnumerable<Product> filteredProducts = new List<Product>();
    private IEnumerable<Category> categories = new List<Category>();
    private int selectedCategoryId = 0;
    private string searchTerm = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        allProducts = await ProductRepository.GetAllAsync();
        categories = allProducts.Select(p => p.Category!).Where(c => c != null).Distinct();
        filteredProducts = allProducts;
    }

    private void OnCategoryChanged(ChangeEventArgs e)
    {
        selectedCategoryId = int.Parse(e.Value?.ToString() ?? "0");
        FilterProducts();
    }

    private void FilterProducts()
    {
        filteredProducts = allProducts.Where(p =>
            (selectedCategoryId == 0 || p.CategoryId == selectedCategoryId) &&
            (string.IsNullOrEmpty(searchTerm) ||
             p.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
             p.Description.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
        );
    }

    // 🛒 МЕТОД ДОБАВЛЕНИЯ В КОРЗИНУ
    private async Task AddToCart(Product product)
    {
        await CartService.AddToCartAsync(product);
        // Принудительно обновляем UI после изменения состояния сервиса
        await InvokeAsync(StateHasChanged);
    }
}